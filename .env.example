# TEMPLATE ONLY — never put a real token in this file.
# Copy it to ".env" in this same folder (App/.env, a FILE not a folder) and put
# the token there instead. Without it the app works fully — it just doesn't
# mirror to Notion, and the footer shows "Notion not configured".
#
# Setup, once:
#   1. Go to https://www.notion.so/my-integrations and click "New integration".
#   2. Give it a name (e.g. "Job Search HQ"), submit, and copy the
#      "Internal Integration Secret".
#   3. Open your "🌍 Job Search HQ" database in Notion → ••• menu →
#      "Connections" → add the integration you just made.
#   4. Paste the secret into .env and restart the app (`npm run dev`).

NOTION_TOKEN=

# Only change this if the database was rebuilt and its data source id moved.
NOTION_DATA_SOURCE_ID=

# Host IP for network access (e.g. Tailscale or local network IP).
# Defaults to 127.0.0.1 for local development.
TAILSCALE_IP=127.0.0.1

# Required before the app is usable at all (login gates every /api/* route).
# Don't set this by hand — run this once from the App folder instead:
#   node scripts/set-password.mjs
# It prompts for a password and writes the hashed value here for you. Run it
# again any time to change the password.
APP_PASSWORD_HASH=

# Auto-generated by the server on first run if missing — signs session
# cookies. No need to set this yourself; leave it blank here.
SESSION_SECRET=

# --- Outreach sections (Direct Approach + Recruiters) ---
# Two Notion databases mirroring App/data/outreach.json. Both are created with the
# SAME union schema on purpose: server/notion.js sends every property on every write,
# and one unknown property name 400s the whole row, so a per-kind property list would
# make that failure reachable again. Unused columns per kind are hidden in the Notion view.
# Leave blank to keep outreach local-only — sync becomes a quiet no-op.
NOTION_OUTREACH_COMPANIES_DS_ID=
NOTION_OUTREACH_RECRUITERS_DS_ID=

# --- Daily wallpaper (Sidebar → Appearance → Daily wallpaper) ---
# Free key from https://www.pexels.com/api/ — used server-side only, the
# browser never sees it. Leave blank to keep the toggle a no-op.
PEXELS_API_KEY=

# --- Telegram notifications ---
# Sends a Telegram message for every entry appended to App/data/audit-log.jsonl
# (new job logged, CV/CL generated, ATS check finished, rejection processed,
# status changed — every action, not a curated subset). Leave either blank to
# keep this off; the server just logs "telegram notify: off" and does nothing.
#
# Setup, once:
#   1. In Telegram, message @BotFather, send /newbot, and follow the prompts
#      (name + a username ending in "bot"). It replies with a token.
#   2. Paste that token below as TELEGRAM_BOT_TOKEN.
#   3. Send any message (e.g. "hi") to your new bot in Telegram.
#   4. Find your chat id by visiting, in a browser:
#      https://api.telegram.org/bot<your token>/getUpdates
#      and reading the "chat":{"id": ...} value from the reply. Paste that
#      below as TELEGRAM_CHAT_ID.
#   5. Restart the app (`npm run dev`).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
